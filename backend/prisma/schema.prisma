// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ==========================================
// From Enum: auth
// ==========================================

enum Role {
  SUPER_ADMIN // Admin toàn hệ thống SaaS
  USER // Người dùng thông thường
}

enum AuthProvider {
  LOCAL
  GOOGLE
}

enum UserStatus {
  PENDING // Mới đăng ký/được mời, chưa verify
  ACTIVE // Đang hoạt động
  INACTIVE // Bị khóa tài khoản
}

// ==========================================
// From Enum: notification
// ==========================================

enum NotificationType {
  TASK_ASSIGNED // Được giao task
  TASK_COMMENT // Có bình luận mới trong task
  MEMBER_INVITED // Được mời vào Workspace
  SYSTEM_ALERT // Thông báo hệ thống
}

// ==========================================
// From Enum: subscription
// ==========================================

// Removed Subscription enums

// ==========================================
// From Enum: task
// ==========================================

enum ProjectStatus {
  PLANNING // Đang lên kế hoạch
  IN_PROGRESS // Đang thực hiện
  COMPLETED // Đã hoàn thành
  ARCHIVED // Đã đóng/lưu trữ
}

enum TaskStatus {
  TODO // Cần làm
  IN_PROGRESS // Đang làm
  IN_REVIEW // Đang duyệt / Code review
  DONE // Hoàn thành
}

enum TaskPriority {
  LOW // Thấp
  MEDIUM // Trung bình
  HIGH // Cao
  URGENT // Khẩn cấp
}

// ==========================================
// From Enum: workspace
// ==========================================

enum WorkspaceRole {
  OWNER // Chủ sở hữu Workspace (quyền cao nhất)
  ADMIN // Quản trị viên (quản lý thành viên, dự án)
  MEMBER // Thành viên chính thức (tạo/sửa task)
  VIEWER // Chỉ có quyền xem
}

enum MemberStatus {
  INVITED // Đã gửi lời mời qua email, chưa chấp nhận
  ACTIVE // Đã tham gia và đang hoạt động
  SUSPENDED // Bị khóa tạm thời trong workspace này
}

// ==========================================
// From Model: activity_log
// ==========================================

model ActivityLog {
  id         String @id @default(uuid())
  action     String // Ví dụ: "TASK_CREATE", "TASK_UPDATE_STATUS", "TASK_MOVE", "COMMENT_CREATE"
  entityType String // Ví dụ: "TASK", "PROJECT", "COMMENT", "MEMBER"
  entityId   String // ID của thực thể được tác động
  entityName String // Tên/Tiêu đề thực thể tại thời điểm tác động

  // Chi tiết thay đổi (JSON lưu trạng thái cũ và mới)
  details Json? @db.JsonB

  // Người thực hiện hành động
  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Tenant Isolation
  workspaceId String    @map("workspace_id")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  // Optional contextual links
  projectId String?  @map("project_id")
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  taskId String? @map("task_id")
  task   Task?   @relation(fields: [taskId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at")

  @@index([workspaceId, createdAt])
  @@index([projectId, createdAt])
  @@index([taskId, createdAt])
  @@map("activity_logs")
}

// ==========================================
// From Model: attachment
// ==========================================

model Attachment {
  id          String @id @default(uuid())
  fileName    String @map("file_name")
  fileSize    Int    @map("file_size")
  mimeType    String @map("mime_type")
  storagePath String @map("storage_path") // Đường dẫn file trên Supabase Bucket
  publicUrl   String @map("public_url") // URL truy cập công khai

  taskId String @map("task_id")
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)

  uploadedById String @map("uploaded_by_id")
  uploadedBy   User   @relation(name: "UserUploadedAttachments", fields: [uploadedById], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([taskId])
  @@map("attachments")
}

// ==========================================
// From Model: checklist
// ==========================================

model Checklist {
  id       String @id @default(uuid())
  title    String // Tên checklist (Ví dụ: "Tiêu chí nghiệm thu", "Các bước triển khai")
  position Float  @default(65535.0)

  taskId String @map("task_id")
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)

  items ChecklistItem[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([taskId])
  @@map("checklists")
}

// ==========================================
// From Model: checklist_item
// ==========================================

model ChecklistItem {
  id          String  @id @default(uuid())
  title       String // Tên công việc con
  isCompleted Boolean @default(false) @map("is_completed")
  position    Float   @default(65535.0)

  checklistId String    @map("checklist_id")
  checklist   Checklist @relation(fields: [checklistId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([checklistId])
  @@map("checklist_items")
}

// ==========================================
// From Model: comment
// ==========================================

model Comment {
  id      String @id @default(uuid())
  content String @db.Text

  taskId String @map("task_id")
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)

  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([taskId])
  @@map("comments")
}

// ==========================================
// From Model: notification
// ==========================================

model Notification {
  id      String           @id @default(uuid())
  title   String
  message String           @db.Text
  type    NotificationType
  isRead  Boolean          @default(false) @map("is_read")
  link    String? // URL hoặc route để điều hướng khi click (ví dụ: "/w/slug/p/key/task-1")

  // Người nhận thông báo
  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // (Optional) Gắn với Workspace để filter theo context
  workspaceId String?    @map("workspace_id")
  workspace   Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId, isRead])
  @@index([createdAt])
  @@map("notifications")
}

// ==========================================
// From Model: password_reset_token
// ==========================================

model PasswordResetToken {
  id        String @id @default(uuid())
  tokenHash String @unique @map("token_hash")
  userId    String @map("user_id")
  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  isUsed    Boolean  @default(false) @map("is_used")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@map("password_reset_tokens")
}

// ==========================================
// From Model: project
// ==========================================

model Project {
  id          String        @id @default(uuid())
  name        String
  key         String // Mã viết tắt dự án (ví dụ: "SAAS", "MOB")
  description String?       @db.Text
  status      ProjectStatus @default(IN_PROGRESS)

  workspaceId String    @map("workspace_id")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  // Soft delete & Audit
  deletedAt DateTime? @map("deleted_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  // Relations
  tasks        Task[]
  columns      ProjectColumn[]
  activityLogs ActivityLog[]

  // Key của dự án không được trùng trong cùng 1 Workspace
  @@unique([workspaceId, key])
  @@index([workspaceId, status])
  @@map("projects")
}

// ==========================================
// From Model: project_column
// ==========================================

model ProjectColumn {
  id       String     @id @default(uuid())
  name     String // Tên cột (Ví dụ: "Cần làm", "Đang tiến hành", "Review", "Đã xong")
  position Float      @default(65535.0) // Thứ tự sắp xếp kéo thả các cột
  status   TaskStatus @default(TODO) // Ánh xạ trạng thái chuẩn phục vụ thống kê báo cáo

  projectId String  @map("project_id")
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  tasks Task[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([projectId, name])
  @@index([projectId, position])
  @@map("project_columns")
}

// ==========================================
// From Model: refresh_token
// ==========================================

model RefreshToken {
  id        String @id @default(uuid())
  tokenHash String @unique @map("token_hash")
  userId    String @map("user_id")
  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  isRevoked Boolean  @default(false) @map("is_revoked")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@map("refresh_tokens")
}

// ==========================================
// From Model: subscription
// ==========================================

// Removed Subscription model

// ==========================================
// From Model: task
// ==========================================

model Task {
  id          String       @id @default(uuid())
  title       String
  description String?      @db.Text
  status      TaskStatus   @default(TODO)
  priority    TaskPriority @default(MEDIUM)
  dueDate     DateTime?    @map("due_date")
  position    Float        @default(65535.0) // Thứ tự sắp xếp kéo/thả Kanban

  projectId String  @map("project_id")
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  columnId String?        @map("column_id")
  column   ProjectColumn? @relation(fields: [columnId], references: [id], onDelete: SetNull)

  assigneeId String? @map("assignee_id")
  assignee   User?   @relation(name: "TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  reporterId String @map("reporter_id")
  reporter   User   @relation(name: "TaskReporter", fields: [reporterId], references: [id], onDelete: Cascade)

  // Soft delete & Audit
  deletedAt DateTime? @map("deleted_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  // Relations
  comments     Comment[]
  attachments  Attachment[]
  checklists   Checklist[]
  labels       TaskLabelRelation[]
  activityLogs ActivityLog[]

  @@index([projectId, status])
  @@index([columnId])
  @@index([assigneeId])
  @@index([position])
  @@map("tasks")
}

// ==========================================
// From Model: task_label
// ==========================================

model TaskLabel {
  id    String @id @default(uuid())
  name  String // Tên nhãn (Ví dụ: "Bug", "Feature", "Refactor")
  color String // Mã màu sắc hiển thị (Ví dụ: "#EF4444")

  workspaceId String    @map("workspace_id")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  tasks TaskLabelRelation[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([workspaceId, name])
  @@map("task_labels")
}

// ==========================================
// From Model: task_label_relation
// ==========================================

model TaskLabelRelation {
  taskId String @map("task_id")
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)

  labelId String    @map("label_id")
  label   TaskLabel @relation(fields: [labelId], references: [id], onDelete: Cascade)

  @@id([taskId, labelId])
  @@map("task_label_relations")
}

// ==========================================
// From Model: user
// ==========================================

model User {
  id       String       @id @default(uuid())
  email    String       @unique
  fullname String
  password String? // Nullable nếu đăng ký bằng Google
  avatar   String?
  provider AuthProvider @default(LOCAL)
  googleId String?      @unique
  phone    String?      @unique
  role     Role         @default(USER)
  status   UserStatus   @default(PENDING)

  // Soft delete & Audit
  deletedAt DateTime? @map("deleted_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  // Relations (Module Auth & Workspace)
  refreshTokens        RefreshToken[]
  passwordResetTokens  PasswordResetToken[]
  workspaceMemberships WorkspaceMember[]
  sentInvitations      WorkspaceInvitation[] @relation("SentInvitations")

  assignedTasks       Task[]       @relation("TaskAssignee")
  reportedTasks       Task[]       @relation("TaskReporter")
  comments            Comment[]
  uploadedAttachments Attachment[] @relation("UserUploadedAttachments")

  notifications Notification[]
  activityLogs  ActivityLog[]

  @@index([status, role])
  @@index([createdAt])
  @@map("users")
}

// ==========================================
// From Model: workspace
// ==========================================

model Workspace {
  id          String  @id @default(uuid())
  name        String // Tên không gian làm việc (ví dụ: "Acme Corp")
  slug        String  @unique // URL-friendly string (ví dụ: "acme-corp")
  logo        String? // URL logo của Workspace
  description String? @db.Text

  // Soft delete & Audit
  deletedAt DateTime? @map("deleted_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  // Relations
  members       WorkspaceMember[]
  invitations   WorkspaceInvitation[]
  projects      Project[]
  labels        TaskLabel[]
  // subscription  Subscription?    // Quan hệ 1-1 (1 Workspace có tối đa 1 Subscription)
  notifications Notification[] // Quan hệ 1-N (Tùy chọn filter notification theo Workspace)
  activityLogs  ActivityLog[]

  @@index([slug])
  @@index([createdAt])
  @@map("workspaces")
}

// ==========================================
// From Model: workspace_invitation
// ==========================================

model WorkspaceInvitation {
  id          String        @id @default(uuid())
  email       String
  workspaceId String        @map("workspace_id")
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  role        WorkspaceRole @default(MEMBER)
  token       String        @unique
  invitedById String        @map("invited_by_id")
  invitedBy   User          @relation(name: "SentInvitations", fields: [invitedById], references: [id], onDelete: Cascade)
  expiresAt   DateTime      @map("expires_at")
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  @@unique([workspaceId, email])
  @@index([token])
  @@map("workspace_invitations")
}

// ==========================================
// From Model: workspace_member
// ==========================================

model WorkspaceMember {
  id String @id @default(uuid())

  workspaceId String    @map("workspace_id")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  role   WorkspaceRole @default(MEMBER)
  status MemberStatus  @default(ACTIVE)

  joinedAt  DateTime? @map("joined_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  // Đảm bảo 1 user không thể xuất hiện 2 lần trong cùng 1 workspace
  @@unique([workspaceId, userId])
  @@index([workspaceId, role])
  @@index([userId])
  @@map("workspace_members")
}
