// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ==========================================
// Nhóm Auth & Core User (First Group)
// ==========================================

enum Role {
  SUPER_ADMIN // Admin toàn hệ thống SaaS
  USER // Người dùng thông thường
}

enum AuthProvider {
  LOCAL
  GOOGLE
}

enum UserStatus {
  PENDING // Mới đăng ký/được mời, chưa verify
  ACTIVE // Đang hoạt động
  INACTIVE // Bị khóa tài khoản
}

model User {
  id       String       @id @default(uuid())
  email    String       @unique
  fullname String
  password String? // Nullable nếu đăng ký bằng Google
  avatar   String?
  provider AuthProvider @default(LOCAL)
  googleId String?      @unique
  phone    String?      @unique
  role     Role         @default(USER)
  status   UserStatus   @default(PENDING)

  // Soft delete & Audit
  deletedAt DateTime? @map("deleted_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  // Relations (Module Auth & Workspace)
  refreshTokens        RefreshToken[]
  passwordResetTokens  PasswordResetToken[]
  workspaceMemberships WorkspaceMember[]

  // Note: uncomment các dòng dưới đây khi tạo các nhóm model tiếp theo
  // notifications        Notification[]
  // assignedTasks        Task[]                @relation("TaskAssignee")
  // reportedTasks        Task[]                @relation("TaskReporter")
  // comments             Comment[]

  @@index([status, role])
  @@index([createdAt])
  @@map("users")
}

model RefreshToken {
  id        String @id @default(uuid())
  tokenHash String @unique @map("token_hash")
  userId    String @map("user_id")
  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  isRevoked Boolean  @default(false) @map("is_revoked")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@map("refresh_tokens")
}

model PasswordResetToken {
  id        String @id @default(uuid())
  tokenHash String @unique @map("token_hash")
  userId    String @map("user_id")
  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  isUsed    Boolean  @default(false) @map("is_used")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@map("password_reset_tokens")
}

// ==========================================
// Nhóm Multi-tenant (Workspace) (Second Group)
// ==========================================

enum WorkspaceRole {
  OWNER // Chủ sở hữu Workspace (quyền cao nhất)
  ADMIN // Quản trị viên (quản lý thành viên, dự án)
  MEMBER // Thành viên chính thức (tạo/sửa task)
  VIEWER // Chỉ có quyền xem
}

enum MemberStatus {
  INVITED // Đã gửi lời mời qua email, chưa chấp nhận
  ACTIVE // Đã tham gia và đang hoạt động
  SUSPENDED // Bị khóa tạm thời trong workspace này
}

model Workspace {
  id          String  @id @default(uuid())
  name        String // Tên không gian làm việc (ví dụ: "Acme Corp")
  slug        String  @unique // URL-friendly string (ví dụ: "acme-corp")
  logo        String? // URL logo của Workspace
  description String? @db.Text

  // Soft delete & Audit
  deletedAt DateTime? @map("deleted_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  // Relations
  members WorkspaceMember[]
  // subscription  Subscription?    // Quan hệ 1-1 (1 Workspace có tối đa 1 Subscription)
  // notifications Notification[]   // Quan hệ 1-N (Tùy chọn filter notification theo Workspace)

  @@index([slug])
  @@index([createdAt])
  @@map("workspaces")
}

model WorkspaceMember {
  id String @id @default(uuid())

  workspaceId String    @map("workspace_id")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  role   WorkspaceRole @default(MEMBER)
  status MemberStatus  @default(ACTIVE)

  joinedAt  DateTime? @map("joined_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  // Đảm bảo 1 user không thể xuất hiện 2 lần trong cùng 1 workspace
  @@unique([workspaceId, userId])
  @@index([workspaceId, role])
  @@index([userId])
  @@map("workspace_members")
}
