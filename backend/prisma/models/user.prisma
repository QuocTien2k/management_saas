model User {
  id             String       @id @default(uuid())
  email          String       @unique
  fullname       String
  password       String?      // Nullable nếu đăng ký bằng Google
  avatar         String?
  provider       AuthProvider @default(LOCAL)
  googleId       String?      @unique
  phone          String?      @unique
  role           Role         @default(USER)
  status         UserStatus   @default(PENDING)

  // Soft delete & Audit
  deletedAt      DateTime?    @map("deleted_at")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  // Relations (Module Auth & Workspace)
  refreshTokens       RefreshToken[]
  passwordResetTokens PasswordResetToken[]
  workspaceMemberships WorkspaceMember[]
  sentInvitations      WorkspaceInvitation[] @relation("SentInvitations")
  
  assignedTasks        Task[]                @relation("TaskAssignee")
  reportedTasks        Task[]                @relation("TaskReporter")
  comments             Comment[]
  uploadedAttachments  Attachment[]          @relation("UserUploadedAttachments")

  notifications        Notification[]
  activityLogs        ActivityLog[]

  @@index([status, role])
  @@index([createdAt])
  @@map("users")
}
