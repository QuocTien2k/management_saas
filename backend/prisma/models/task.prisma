model Task {
  id          String       @id @default(uuid())
  title       String
  description String?      @db.Text
  status      TaskStatus   @default(TODO)
  priority    TaskPriority @default(MEDIUM)
  dueDate     DateTime?    @map("due_date")
  position    Float        @default(65535.0) // Thứ tự sắp xếp kéo/thả Kanban

  projectId   String       @map("project_id")
  project     Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)

  columnId    String       @map("column_id")
  column      ProjectColumn @relation(fields: [columnId], references: [id], onDelete: Restrict)

  assigneeId  String?      @map("assignee_id")
  assignee    User?        @relation(name: "TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  reporterId  String       @map("reporter_id")
  reporter    User         @relation(name: "TaskReporter", fields: [reporterId], references: [id], onDelete: Cascade)

  // Soft delete & Audit
  deletedAt   DateTime?    @map("deleted_at")
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  // Relations
  comments    Comment[]
  attachments Attachment[]
  checklists  Checklist[]
  labels      TaskLabelRelation[]
  activityLogs ActivityLog[]

  @@index([projectId, status])
  @@index([columnId])
  @@index([assigneeId])
  @@index([position])
  @@map("tasks")
}
